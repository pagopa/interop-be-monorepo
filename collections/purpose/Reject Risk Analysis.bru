meta {
  name: Reject Risk Analysis
  type: http
  seq: 16
}

post {
  url: {{host-purpose}}/purposes/:purposeId/riskAnalysis/reject
  body: json
  auth: none
}

params:path {
  purposeId: {{purposeId}}
}

headers {
  Authorization: {{JWT}}
  X-Correlation-Id: {{correlation-id}}
}

body:json {
  {
    "rejectionReason": "This risk analysis is incomplete and needs revision"
  }
}

docs {
  Reject a submitted risk analysis as an assigned reviewer in AdminWritesReviewerSigns mode.
  HTTP 409 codes: 004-0066 already approved, 004-0067 already rejected.
  Other conflicts retain their original codes. The mutation is never retried.
}
