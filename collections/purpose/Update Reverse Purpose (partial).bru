meta {
  name: Update Reverse Purpose (partial)
  type: http
  seq: 20
}

patch {
  url: {{host-purpose}}/reverse/purposes/:id
  body: json
  auth: none
}

params:path {
  id: {{reversePurposeId}}
}

headers {
  Authorization: {{JWT-M2M-ADMIN}}
  X-Correlation-Id: {{correlation-id}}
}

body:json {
  {
      "title": "{{randomName}}",
      "description": "a purpose long description updated"
  }
}

docs {
  Updates title and description without changing purpose versions or risk analysis.
  Purposes created from a template cannot be updated through this endpoint.
  Operational fields (dailyCalls, isFreeOfCharge and freeOfChargeReason)
  may be included only for Draft purposes. Otherwise the entire request is rejected with 409.
  riskAnalysisForm is not accepted on the reverse purpose route.
  Repeating current values succeeds without events or a metadata version increment.
}

script:pre-request {
  const random = Math.round(Math.random() * 100)
  
  bru.setVar("randomName",`test name ${random}`)
}
