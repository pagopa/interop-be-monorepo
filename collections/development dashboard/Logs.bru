meta {
  name: Logs
  type: http
  seq: 3
}

get {
  url: {{host-dashboard}}/__local-dashboard/api/logs?limit=500
  body: none
  auth: none
}

params:query {
  limit: 500
  ~source: preset:tenant-seeding
  ~search: correlation-id
}

docs {
  Enable source to view a preset's package and orchestration logs.
  Use preset:<id> from Status; fullstack presets include frontend and checks.
  Use group:packages for backend package logs or group:infra for infrastructure logs.
  These groups exclude orchestration, frontend and check logs.
  Search matches message text or correlation IDs, case-insensitively and by substring.
}
