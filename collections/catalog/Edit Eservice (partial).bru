meta {
  name: Edit Eservice (partial)
  type: http
  seq: 34
}

patch {
  url: {{host-catalog}}/eservices/:eserviceId
  body: json
  auth: none
}

params:path {
  eserviceId: {{eserviceId}}
}

headers {
  Authorization: {{JWT-M2M-ADMIN}}
  X-Correlation-Id: {{correlation-id}}
}

body:json {
  {
    "name": "Updated name",
    "description": "test eservice updated"
  }
}

docs {
  Update name and description independently of descriptor count or state.
  Template instances cannot be updated directly.
  Operational fields can be included with no descriptors or a single Draft descriptor;
  otherwise the whole request fails with 409.
  Unchanged values do not create events or increment X-Metadata-Version.
}
