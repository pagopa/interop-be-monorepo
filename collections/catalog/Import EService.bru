meta {
  name: Import EService
  type: http
  seq: 41
}

post {
  url: {{host-catalog}}/import/eservices
  body: json
  auth: none
}

headers {
  Authorization: {{JWT}}
  X-Correlation-Id: {{correlation-id}}
}

body:json {
  {
      "name": "{{randomName}}",
      "description": "this is an imported eservice",
      "technology": "REST",
      "mode": "DELIVER",
      "descriptor": {
          "description": "imported descriptor description",
          "audience": [ "string" ],
          "voucherLifespan": 86400,
          "dailyCallsPerConsumer": 100,
          "dailyCallsTotal": 100,
          "agreementApprovalPolicy": "MANUAL",
          "interface": {
              "documentId": "{{randomInterfaceId}}",
              "prettyName": "Interface",
              "filePath": "eservices/docs/5d6d2677-f6b3-4c2a-ae25-d9685cb464b0/api.yaml",
              "fileName": "api.yaml",
              "contentType": "application/yaml",
              "checksum": "interfaceChecksum",
              "serverUrls": [
                  "http://server.com"
              ]
          },
          "docs": [
              {
                  "documentId": "{{randomDocumentId}}",
                  "prettyName": "Test Document",
                  "filePath": "eservices/docs/5d6d2677-f6b3-4c2a-ae25-d9685cb464b0/testfile",
                  "fileName": "testfile",
                  "contentType": "test",
                  "checksum": "documentChecksum",
                  "serverUrls": []
              }
          ]
      },
      "riskAnalysis": []
  }
}

vars:post-response {
  eserviceId: res.body.eservice.id
  descriptorId: res.body.createdDescriptorId
}

script:pre-request {
  const { v4 } = require('uuid');
  const random = Math.round(Math.random() * 100)

  bru.setVar("randomName",`imported eservice ${random}`)
  bru.setVar("randomInterfaceId", v4() )
  bru.setVar("randomDocumentId", v4() )
}
