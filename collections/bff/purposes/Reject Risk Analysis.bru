meta {
  name: Reject Risk Analysis
  type: http
  seq: 1
}

post {
  url: {{host-bff}}/purposes/:purposeId/riskAnalysis/reject
  body: json
  auth: none
}

params:path {
  purposeId: {{purposeId}}
}

headers {
  Authorization: {{JWT}}
}

body:json {
  {
    "rejectionReason": "This risk analysis is incomplete and needs revision"
  }
}

docs {
  Reject a submitted risk analysis as an assigned reviewer in
  AdminWritesReviewerSigns mode.

  HTTP 409 codes: 008-0052 already approved, 008-0053 already rejected.
  Other conflicts retain their original process codes. The mutation is not retried.

  Example HTTP 409 (already rejected):
  {
    "type": "about:blank",
    "status": 409,
    "title": "Risk analysis already rejected",
    "detail": "The risk analysis for purpose <purposeId> has already been rejected",
    "correlationId": "<correlationId>",
    "errors": [{ "code": "008-0053", "detail": "The risk analysis for purpose <purposeId> has already been rejected" }]
  }
}
