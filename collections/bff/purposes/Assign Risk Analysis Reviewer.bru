meta {
  name: Assign Risk Analysis Reviewer
  type: http
  seq: 1
}

post {
  url: {{host-bff}}/purposes/:purposeId/riskAnalysis/assign
  body: json
  auth: none
}

params:path {
  purposeId: {{purposeId}}
}

headers {
  Authorization: {{JWT}}
}

body:json {
  {
    "reviewMode": "REVIEWER_WRITES_REVIEWER_SIGNS",
    "reviewerIds": ["{{reviewerId}}"]
  }
}

docs {
  HTTP 409 with code 008-0052 means that the risk analysis has already been approved.
  Rejected risk analyses can still be assigned. Other conflicts retain their
  original process codes; the mutation is not retried.

  Example HTTP 409:
  {
    "type": "about:blank",
    "status": 409,
    "title": "Risk analysis already approved",
    "detail": "The risk analysis for purpose <purposeId> has already been approved",
    "correlationId": "<correlationId>",
    "errors": [{ "code": "008-0052", "detail": "The risk analysis for purpose <purposeId> has already been approved" }]
  }
}
