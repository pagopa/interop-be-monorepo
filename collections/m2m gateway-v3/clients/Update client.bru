meta {
  name: Update client
  type: http
  seq: 14
}

patch {
  url: {{host-m2m-gw-v3}}/clients/{{clientId}}
  body: json
  auth: none
}

headers {
  Authorization: {{DPOP-JWT-M2M-ADMIN}}
  DPoP: {{DPOP-PROOF}}
  Content-Type: application/merge-patch+json
}

body:json {
  {
    "name": "Updated client name",
    "description": "Updated client description"
  }
}
