meta {
  name: Delete eservice descriptor certified attribute from group
  type: http
  seq: 42
}

delete {
  url: {{host-m2m-gw-v3}}/eservices/:eserviceId/descriptors/:descriptorId/certifiedAttributes/groups/:groupIndex/attributes/:attributeId
  body: none
  auth: none
}

params:path {
  groupIndex: {{groupIndex}}
  eserviceId: {{eserviceId}}
  descriptorId: {{descriptorId}}
  attributeId: {{attributeId}}
}

headers {
  Authorization: {{DPOP-JWT-M2M-ADMIN}}
  DPoP: {{DPOP-PROOF}}
}