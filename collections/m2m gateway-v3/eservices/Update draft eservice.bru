meta {
  name: Partially update eservice
  type: http
  seq: 19
}

patch {
  url: {{host-m2m-gw-v3}}/eservices/:eserviceId
  body: json
  auth: none
}

params:path {
  eserviceId: {{eserviceId}}
}

headers {
  Authorization: {{DPOP-JWT-M2M-ADMIN}}
  DPoP: {{DPOP-PROOF}}
  Content-Type: application/merge-patch+json
}

body:json {
  {
    "name": "Updated name",
    "description": "test eservice updated"
  }

}

docs {
  Update metadata of a non-template E-Service regardless of descriptor states.
  At least one field is required; an empty object returns 400.
  Omitted fields remain unchanged; unchanged values create no events or new version.
  Operational fields retain the existing Draft rules; violations return 409 atomically.
  Returns the updated E-Service after read-model polling. Dedicated PATCH routes remain available.
}
