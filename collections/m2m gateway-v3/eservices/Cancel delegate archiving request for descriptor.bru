meta {
  name: Cancel delegate archiving request for a Descriptor
  type: http
  seq: 45
}

delete {
  url: {{host-m2m-gw-v3}}/eservices/:eServiceId/descriptors/:descriptorId/submitDelegatedArchiving
  body: json
  auth: none
}

params:path {
  eserviceId: {{eserviceId}}
  descriptorId: {{descriptorId}}
}

headers {
  Authorization: {{DPOP-JWT-M2M-ADMIN}}
  DPoP: {{DPOP-PROOF}}
}
