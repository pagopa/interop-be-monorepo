meta {
  name: Create eservice template version certified discrete attributes group
  type: http
  seq: 32
}

post {
  url: {{host-m2m-gw-v3}}/eserviceTemplates/:templateId/versions/:versionId/certifiedDiscreteAttributes/groups
  body: json
  auth: none
}

params:path {
  versionId: {{versionId}}
  templateId: {{templateId}}
}

headers {
  Authorization: {{DPOP-JWT-M2M-ADMIN}}
  DPoP: {{DPOP-PROOF}}
}

body:json {
  {
    "attributes": [
      {
        "id": "720c96ac-4068-4e9f-84a8-12cf2c12f5e5",
        "discreteConfig": {
          "threshold": 1,
          "comparator": "EQ"
        }
      }
    ]
  }
}
