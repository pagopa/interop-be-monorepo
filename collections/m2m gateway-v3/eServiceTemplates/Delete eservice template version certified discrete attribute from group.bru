meta {
  name: Delete eservice template version certified discrete attribute from group
  type: http
  seq: 33
}

delete {
  url: {{host-m2m-gw-v3}}/eserviceTemplates/:templateId/versions/:versionId/certifiedDiscreteAttributes/groups/:groupIndex/attributes/:attributeId
  body: none
  auth: none
}

