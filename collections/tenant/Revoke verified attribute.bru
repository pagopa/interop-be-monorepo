meta {
  name: Revoke verified attribute
  type: http
  seq: 23
}

delete {
  url: {{host-tenant}}/tenants/:tenantId/attributes/verified/:attributeId?agreementId={{agreementId}}&delegationId={{delegationId}}
  body: none
  auth: none
}

params:query {
  agreementId: {{agreementId}}
  delegationId: {{delegationId}}
}

params:path {
  tenantId: {{tenantId}}
  attributeId: {{attributeId}}
}

headers {
  Authorization: {{JWT}}
  X-Correlation-Id: {{correlation-id}}
}
