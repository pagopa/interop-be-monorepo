meta {
  name: Verify verified attribute
  type: http
  seq: 22
}

post {
  url: {{host-tenant}}/tenants/:tenantId/attributes/verified
  body: json
  auth: none
}

params:path {
  tenantId: {{tenantId}}
}

headers {
  Authorization: {{JWT}}
  X-Correlation-Id: {{correlation-id}}
}

body:json {
  {
    "id": "{{attributeId}}",
    "agreementId": "{{agreementId}}",
    "delegationId": "{{delegationId}}"
  }
}
