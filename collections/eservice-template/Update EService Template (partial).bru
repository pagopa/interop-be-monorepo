meta {
  name: Update EService Template (partial)
  type: http
  seq: 2
}

patch {
  url: {{host-template}}/templates/:eserviceTemplateId
  body: json
  auth: none
}

params:path {
  eserviceTemplateId: {{eserviceTemplateId}}
}

headers {
  x-correlation-id: {{correlation-id}}
  Authorization: {{JWT}}
}

body:json {
  {
    "name": "Updated template name",
    "description": "Updated description of the EService template",
    "intendedTarget": "Updated intended target of the EService template"
  }
}
