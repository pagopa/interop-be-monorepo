{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": [
    "-lintignore"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "docker/dev-dashboard/generate-compose.mjs",
        "docker/dev-dashboard/stage-bootstrap.mjs",
        "docker/selfcare-mock/selfcare-mock.mjs",
        "scripts/local-development/test/dashboard-compose.test.mjs",
        "scripts/local-development/test/dashboard-runtime.test.mjs"
      ]
    },
    "packages/dev-dashboard-api": {
      "entry": [
        "src/index.ts",
        "test/fixtures/crash.ts"
      ]
    },
    "packages/dev-dashboard-contracts": {
      "ignoreDependencies": [
        "@zodios/core"
      ]
    },
    "packages/dev-dashboard-ui": {
      "entry": [
        "src/main.tsx",
        "public/fonts/fonts.css"
      ]
    }
  },
  "ignoreDependencies": [
    "prettier",
    "@types/qs",
    "qs",
    "@protobuf-ts/plugin"
  ],
  "ignoreBinaries": [
    "tsx"
  ],
  "ignore": [
    "packages/documents-generator/src/pdf-generator/paged.polyfill.js",
    "packages/documents-generator/src/model/purposeTemplateModels.ts"
  ],
  "ignoreIssues": {
    "packages/api-clients/src/axiosLogInterceptors.ts": [
      "exports"
    ],
    "packages/m2m-event-db-models/src/config/config.ts": [
      "exports"
    ],
    "packages/notifier-seeder/src/protobuf-models/v1/events.ts": [
      "exports",
      "types"
    ],
    "packages/m2m-gateway/test/multipartTestUtils.ts": [
      "exports",
      "types"
    ]
  }
}
