{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "daemon": false,
  "globalDependencies": [
    "tsconfig.json"
  ],
  "globalEnv": [
    "CI"
  ],
  "tasks": {
    "start": {
      "persistent": true,
      "cache": false,
      "dependsOn": [
        "^build",
        "//#infra:start"
      ]
    },
    "//#infra:start": {
      "cache": false
    },
    "//#infra:stop": {
      "cache": false
    },
    "//#infra:destroy": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "generate-model",
        "generate-protobuf",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "pagopa-interop-error-messages#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "src/generated/**"
      ]
    },
    "pagopa-interop-error-messages#check": {
      "dependsOn": [
        "^build",
        "^check"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "generate-error-messages": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "validate-error-messages": {
      "dependsOn": [
        "generate-error-messages"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/backend-for-frontend/src/routers/**"
      ],
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "generate-model",
        "generate-protobuf",
        "^build",
        "^check"
      ],
      "outputs": []
    },
    "generate-model": {
      "dependsOn": [
        "^generate-model"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "generate-protobuf": {
      "dependsOn": [
        "^generate-protobuf"
      ],
      "outputs": [
        "src/gen/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build",
        "^test",
        "test:integration",
        "test:api"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "build",
        "^test:integration"
      ]
    },
    "test:api": {
      "dependsOn": [
        "build",
        "^test:api"
      ]
    },
    "lint": {
      "dependsOn": [
        "build",
        "^lint"
      ],
      "outputs": [
        ".eslintcache"
      ]
    },
    "pagopa-interop-error-messages#lint": {
      "dependsOn": [
        "build",
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/backend-for-frontend/src/routers/**"
      ],
      "outputs": [
        ".eslintcache"
      ]
    },
    "lint:autofix": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "dist"
      ]
    },
    "lint:openapi": {
      "dependsOn": [
        "^lint:openapi"
      ],
      "cache": false
    },
    "generate-db-models": {
      "dependsOn": [
        "//#infra:start",
        "^generate-db-models"
      ],
      "outputs": [
        "src/generated/**"
      ]
    }
  }
}