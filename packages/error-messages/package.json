{
  "name": "error-messages",
  "private": true,
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Generate and validate typed error messages from CSV",
  "type": "module",
  "scripts": {
    "lint": "eslint . && pnpm validate",
    "lint:autofix": "eslint . --fix",
    "generate": "tsx cli/cli.ts generate",
    "validate": "tsx cli/cli.ts validate",
    "build": "pnpm generate && tsc",
    "check": "pnpm generate && tsc --project tsconfig.check.json",
    "test": "vitest"
  },
  "keywords": [],
  "devDependencies": {
    "@types/node": "catalog:",
    "@cspell/dict-it-it": "catalog:",
    "cspell-lib": "catalog:",
    "commander": "catalog:",
    "csv": "catalog:",
    "pagopa-interop-commons": "workspace:*",
    "csv-stringify": "catalog:",
    "eslint": "catalog:",
    "pagopa-interop-eslint-config": "workspace:*",
    "ts-pattern": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "pagopa-interop-models": "workspace:*"
  }
}
