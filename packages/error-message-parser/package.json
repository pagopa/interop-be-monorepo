{
  "name": "pagopa-interop-error-message-parser",
  "private": true,
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Generate typed error messages from CSV",
  "main": "dist",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:autofix": "eslint . --fix",
    "generate-error-message": "tsx scripts/generateErrorMessages.ts",
    "build": "pnpm generate-error-message && tsc",
    "check": "pnpm generate-error-message && tsc --project tsconfig.check.json",
    "test": "vitest",
    "test:it": "vitest integration"
  },
  "keywords": [],
  "devDependencies": {
    "@types/node": "catalog:",
    "csv-stringify": "catalog:",
    "eslint": "catalog:",
    "pagopa-interop-eslint-config": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "csv": "catalog:",
    "pagopa-interop-commons": "workspace:*",
    "pagopa-interop-models": "workspace:*"
  }
}