LOG_LEVEL=INFO

KAFKA_LOG_LEVEL=INFO
KAFKA_CLIENT_ID="email-sender-consumer"
KAFKA_GROUP_ID="email-sender-group-local"
KAFKA_BROKERS="localhost:9092"
TOPIC_STARTING_OFFSET="latest"
KAFKA_DISABLE_AWS_IAM_AUTH="true"

SENDER_MAIL="sender@test.com"
SENDER_LABEL="sender"
RETRY_DELAY_IN_MILLIS=1000
SUCCESS_DELAY_IN_MILLIS=100

AWS_REGION="eu-south-1"
AWS_SES_ENDPOINT="http://localhost:8005"
AWS_CONFIG_FILE=aws.config.local

EMAIL_DISPATCH_TOPIC="email-dispatch.emails"

SELFCARE_API_MAX_RETRIES=3
SELFCARE_API_RETRY_DELAY_IN_MILLIS=1000
SELFCARE_V2_URL="http://localhost:8006"
SELFCARE_V2_API_KEY="test"

CONTACT_DATA_MANAGER_URL="http://localhost:4200"
INTERNAL_JWT_KID=ffcc9b5b-4612-49b1-9374-9d203a3834f2
INTERNAL_JWT_SUBJECT="dev.interop-email-sender"
INTERNAL_JWT_ISSUER="dev.interop.pagopa.it"
INTERNAL_JWT_AUDIENCE="dev.interop.pagopa.it/internal"
INTERNAL_JWT_SECONDS_DURATION=60
